<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora_main"
    android:fitsSystemWindows="false"
    tools:context=".ui.home.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_aurora_main">

        <!-- Edge-to-Edge Banner -->
        <!-- Bọc ViewPagerBanner trong một layout mờ (Gradient) phía dưới -->
        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Lớp sương mù che phần dưới của banner hòa vào nền -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_fade_bottom" />
        </FrameLayout>

        <!-- Header trong suốt, lơ lửng trên banner -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvAppLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="CINEMATIC"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />
                
            <!-- Có thể thêm Icon Search/Profile ở đây nếu cần -->
        </LinearLayout>

        <!-- Container chứa nội dung dưới Banner -->
        <LinearLayout
            android:id="@+id/main_content_holder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_marginTop="-40dp"
            app:layout_constraintTop_toBottomOf="@id/bannerContainer"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Tabs: Pill Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="48dp"
                android:elevation="2dp">

                <LinearLayout
                    android:id="@+id/tabRow"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_pill_track"
                    android:padding="4dp"
                    android:orientation="horizontal">

                    <!-- Vì logic cũ dùng tabIndicatorLine để trượt, ta vẫn giữ nhưng ẩn nó đi, 
                         hoặc dùng background đổi màu trong code. Ta sẽ bọc textview để không phá logic -->
                    <TextView
                        android:id="@+id/tabDangChieu"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Đang chiếu"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_pill_selected" />

                    <TextView
                        android:id="@+id/tabSapChieu"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Sắp chiếu"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Giữ lại track nhưng ẩn đi để tránh lỗi logic nếu MainActivity có dùng ViewPropertyAnimator -->
                <FrameLayout
                    android:id="@+id/tabIndicatorTrack"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="invisible">
                    <View
                        android:id="@+id/tabIndicatorLine"
                        android:layout_width="10dp"
                        android:layout_height="1dp" />
                </FrameLayout>
            </LinearLayout>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerMovies"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="72dp"
                android:paddingTop="20dp"
                android:paddingBottom="4dp" />

            <!-- Thông tin phim -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvSelectedTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Tên phim"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvSelectedInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Thể loại • Thời lượng"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Nút đặt vé kéo dài, bo góc lớn -->
            <FrameLayout
                android:id="@+id/layoutMovieSelectionBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="32dp"
                android:paddingBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBookNow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/gradient_button"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:text="@string/movie_detail_book_ticket"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    app:backgroundTint="@null"
                    app:cornerRadius="24dp"
                    app:rippleColor="#44FFFFFF" />
            </FrameLayout>

        </LinearLayout>

        <!-- Floating Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_floating_nav"
            android:elevation="12dp"
            android:minHeight="64dp"
            app:itemActiveIndicatorStyle="@style/MovieActiveIndicator.BottomNav"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/text_primary"
            app:itemRippleColor="#18FFFFFF"
            app:itemTextAppearanceActive="@style/MovieTextAppearance.BottomNav.Active"
            app:itemTextAppearanceInactive="@style/MovieTextAppearance.BottomNav.Inactive"
            app:itemTextColor="@color/text_primary"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar menu (Nếu có dùng DrawerLayout) -->
    <LinearLayout
        android:id="@+id/sidebar_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/bg_midnight_blue"
        android:orientation="vertical"
        android:padding="16dp" />

</androidx.drawerlayout.widget.DrawerLayout>
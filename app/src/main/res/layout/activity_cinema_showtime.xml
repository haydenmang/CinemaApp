<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#161616"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            android:padding="4dp"
            app:tint="#E50914" />

        <TextView
            android:id="@+id/tvMovieTitleHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="RẠP &amp; SUẤT CHIẾU"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            tools:ignore="HardcodedText" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Banner với gradient overlay phía dưới -->
    <FrameLayout
        android:id="@+id/bannerFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/rvDateSelector"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHeight_percent="0.22">

        <ImageView
            android:id="@+id/ivMovieBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="false"
            android:contentDescription="Movie Banner"
            android:scaleType="centerCrop"
            android:src="@drawable/my_banner" />

        <!-- Gradient mờ dần từ dưới lên -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_overlay" />

    </FrameLayout>

    <!-- Date selector -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDateSelector"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#161616"
        app:layout_constraintTop_toBottomOf="@id/bannerFrame"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:orientation="horizontal" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#252525"
        app:layout_constraintTop_toBottomOf="@id/rvDateSelector" />

    <!-- Danh sách rạp -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCinemaList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0D0D0D"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider"
        tools:listitem="@layout/item_cinema_showtime" />

</androidx.constraintlayout.widget.ConstraintLayout>
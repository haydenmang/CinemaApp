<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Icon -->
        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="#F57C00"
                android:layout_gravity="center"/>
        </androidx.cardview.widget.CardView>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/txtUpcomingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sắp đến giờ chiếu!"
                    android:textColor="#202124"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/txtUpcomingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 phút trước"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtUpcomingMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phim Lật Mặt 7 sẽ bắt đầu lúc 19:00 hôm nay tại CGV Vincom Center. Hãy đến rạp sớm 15 phút để lấy vé và chuẩn bị bắp nước nhé!"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MỞ MÃ VÉ QR"
                android:textColor="#DE3716"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="false"
        android:focusable="false">

        <!-- Thanh đỏ bên trái -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#E50914"
            android:minHeight="60dp" />

        <!-- Icon -->
        <ImageView
            android:id="@+id/ivCinemaLogo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Logo"
            android:padding="9dp"
            android:layout_marginStart="12dp"
            android:background="#252525"
            app:tint="#E50914" />

        <!-- Tên + địa chỉ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/tvCinemaName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCinemaAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#777777"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <!-- Arrow -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="14dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Go"
            android:visibility="gone"
            app:tint="#E50914" />

    </LinearLayout>

    <View android:id="@+id/dividerShowtime" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/cgShowtimes" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_cinema"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay" />

    <com.example.cinemaapp.ui.movie.widget.ParticleView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/tvEmoji"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/gengar"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/gengar_circle"
            android:alpha="0" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CinemaApp"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:alpha="0" />

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đặt vé dễ dàng, trải nghiệm tuyệt vời"
            android:textSize="14sp"
            android:textColor="#E74C3C"
            android:layout_marginTop="8dp"
            android:alpha="0" />

    </LinearLayout>
</FrameLayout>

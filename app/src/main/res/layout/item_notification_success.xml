<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Icon -->
        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#4CAF50"
                android:layout_gravity="center"/>
        </androidx.cardview.widget.CardView>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/txtSuccessTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đặt vé thành công!"
                    android:textColor="#202124"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/txtSuccessTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hôm qua"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtSuccessMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cảm ơn bạn đã đặt vé. Dưới đây là thông tin vé của bạn:"
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:layout_marginTop="6dp"/>

            <!-- Ticket Info Block -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F8F9FA"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- Movie Poster -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="60dp"
                        android:layout_height="85dp"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="12dp">
                        <ImageView
                            android:id="@+id/imgTicketPoster"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_gallery"
                            android:scaleType="centerCrop"
                            android:background="#E0E0E0"/>
                    </androidx.cardview.widget.CardView>

                    <!-- Text Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtTicketMovieTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lật Mặt 7: Một Điều Ước"
                            android:textColor="#202124"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/txtTicketCinemaName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CGV Vincom Center"
                            android:textColor="#5F6368"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">
                            <TextView
                                android:id="@+id/txtTicketTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="19:00 - 20/05"
                                android:textColor="#5F6368"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/txtTicketSeat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ghế: H8, H9"
                                android:textColor="#DE3716"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XEM CHI TIẾT VÉ"
                android:textColor="#1A73E8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora_main">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvMovieTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chọn ghế"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:gravity="center" />

        <!-- Nút Reset hoặc Info nếu có -->
        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_info_details"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvShowtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="19:30 - Hôm nay"
        android:textColor="@color/aurora_cyan"
        android:textSize="13sp"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Màn chiếu sáng Neon Glow -->
    <View
        android:id="@+id/screen"
        android:layout_width="300dp"
        android:layout_height="8dp"
        android:background="@drawable/screen_shape"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvShowtime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Đổ bóng của màn chiếu -->
    <View
        android:layout_width="320dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_screen_glow"
        app:layout_constraintTop_toBottomOf="@id/screen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvScreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MÀN HÌNH"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/screen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sơ đồ ghế -->
    <HorizontalScrollView
        android:id="@+id/scrollSeats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvScreen"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/seatContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center" />
        </ScrollView>
    </HorizontalScrollView>

    <!-- Panel lơ lửng chứa Note và Đặt vé -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="24dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Legend -->
            <LinearLayout
                android:id="@+id/legendLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingBottom="12dp">

                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/seat_empty" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Trống" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginStart="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/seat_selected" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Đang chọn" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginStart="4dp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <View android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/seat_booked" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Đã đặt" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_border_dim"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSelectedSeats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa chọn ghế"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 đ"
                        android:textColor="@color/aurora_cyan"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="normal" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="140dp"
                    android:layout_height="52dp"
                    android:text="Tiếp tục"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:background="@drawable/gradient_button"
                    app:backgroundTint="@null"
                    app:cornerRadius="26dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

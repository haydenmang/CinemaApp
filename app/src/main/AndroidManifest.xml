<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.youtube.com" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnd.youtube" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CinemaApp"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.user.MyTicketActivity"
            android:exported="false" />
        <activity
            android:name=".ui.movie.MovieListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.NotificationActivity"
            android:exported="false" />
        <activity
            android:name=".ui.user.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.user.SettingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CinemaApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.booking.CinemaShowtimeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.movie.detail.MovieDetailActivity"
            android:exported="false" />


        <activity
            android:name=".ui.booking.SeatSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.booking.MovieByCinemaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.booking.ChooseMovieActivity"
            android:exported="false" />

        <activity
            android:name=".ui.booking.ComboActivity"
            android:exported="false" />

        <activity
            android:name=".ui.booking.PaymentActivity"
            android:exported="false" />

        <activity
            android:name=".ui.booking.TicketActivity"
            android:exported="false" />
    </application>

</manifest>